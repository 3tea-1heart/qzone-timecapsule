<Window x:Class="QZoneArchive.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="时光留存 · QQ 空间备份" Width="1180" Height="850" MinWidth="960" MinHeight="780" Background="#EEF3F8" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#344452" WindowStartupLocation="CenterScreen">
 <Window.Resources>
<Style TargetType="TabItem"><Setter Property="Padding" Value="22,14"/><Setter Property="Margin" Value="8,8,0,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBorder" Background="#E3ECF3" CornerRadius="9,9,0,0" Padding="{TemplateBinding Padding}"><ContentPresenter x:Name="TabHeader" ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#477FAD"/><Setter TargetName="TabHeader" Property="TextElement.Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="ListBoxItem"><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="#E1EBF3"/><Setter Property="Foreground" Value="#3D657F"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10,9"/><Setter Property="BorderBrush" Value="#CEDDE9"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,8,0,0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#DFEAF3" Padding="25,32"><DockPanel>
   <StackPanel DockPanel.Dock="Top"><TextBlock Text="时光留存" FontSize="27" FontWeight="Bold"/><TextBlock Text="MY SPACE / TIME CAPSULE" FontSize="10" Margin="0,7,0,35" Foreground="#6F8AA0"/>
    <TextBlock Text="把那些日子，&#10;存进空间。" FontSize="25" FontFamily="SimSun" LineHeight="40"/><TextBlock Text="从一条说说，到完整的回忆。" Margin="0,15,0,30" Foreground="#6F8AA0"/>
   </StackPanel>
   <StackPanel DockPanel.Dock="Bottom"><TextBlock Text="本地保存 · 不上传备份内容" FontSize="12" Foreground="#687E68"/><TextBlock Text="v1.2.1  /  Windows x64" FontSize="11" Margin="0,7,0,0" Foreground="#81907C"/></StackPanel>
   <StackPanel><TextBlock Text="01  连接你的空间" FontWeight="Bold" Margin="0,5,0,10"/><TextBlock x:Name="AccountLabel" Text="尚未登录" Foreground="#6F8AA0" Margin="0,0,0,14" TextWrapping="Wrap"/>
    <Button x:Name="LoginButton" Content="打开扫码登录窗口" Click="Login_Click" Background="#477FAD" Foreground="White"/>
    <Button x:Name="LogoutButton" Content="退出登录 / 清除会话" Click="Logout_Click" Margin="0,10,8,0"/>
    <Separator Margin="0,25" Background="#C9D5C1"/>
    <TextBlock Text="备份包含什么？" FontWeight="Bold"/><TextBlock Text="说说全文与转发正文&#10;图片、日期时间&#10;评论与接口返回的回复&#10;JSON 原始记录与核对报告" TextWrapping="Wrap" LineHeight="29" Foreground="#6A8194" Margin="0,12,0,0"/>
    <Button Content="预览示例档案 ↗" Click="Demo_Click" Margin="0,22,8,0"/>
   </StackPanel>
  </DockPanel></Border>
  <TabControl Grid.Column="1" x:Name="WorkspaceTabs" Background="#EEF3F8" BorderThickness="0" Padding="0"><TabItem Header="01  空间采集"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="34,28,34,26">
   <TextBlock Text="YOUR MEMORIES, PRESERVED." FontSize="10" Foreground="#68816C"/><TextBlock Text="备份你的 QQ 空间" FontSize="29" FontWeight="SemiBold" Margin="0,8,0,7"/>
   <TextBlock Text="扫码登录 → 选择保存位置 → 开始备份。随时停止，下次继续补采。" Foreground="#78867B" TextWrapping="Wrap"/>
   <Border Background="#FFFFFF" BorderBrush="#E0E5D9" BorderThickness="1" CornerRadius="12" Padding="23" Margin="0,24,0,18"><StackPanel x:Name="OptionsPanel">
    <TextBlock Text="02  选择范围与保存位置" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock Text="目标 QQ 号（留空 = 当前登录账号）" FontSize="12" Margin="0,0,0,7"/><TextBox x:Name="TargetBox" ToolTip="填写其他 QQ 号可导出当前登录账号有权限访问的空间"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="请求间隔" FontSize="12" Margin="0,0,0,7"/><ComboBox x:Name="SpeedBox" SelectedIndex="0" Padding="8" Height="38"><ComboBoxItem Content="标准 · 1.8 秒"/><ComboBoxItem Content="稳妥 · 3 秒"/><ComboBoxItem Content="慢速 · 5 秒"/><ComboBoxItem Content="快速 · 0.8 秒"/></ComboBox></StackPanel></Grid>
    <TextBlock Text="保存到（自动按目标 QQ 号建立子文件夹）" FontSize="12" Margin="0,16,0,7"/><DockPanel><Button Content="选择…" DockPanel.Dock="Right" Click="Folder_Click" Margin="9,0,0,0"/><TextBox x:Name="FolderBox"/></DockPanel>
    <WrapPanel Margin="0,9,0,0"><CheckBox x:Name="MediaCheck" Content="下载图片" IsChecked="True" Margin="0,8,20,0"/><CheckBox x:Name="VideoCheck" Content="下载视频 / 音频" IsChecked="True" Margin="0,8,20,0"/><CheckBox x:Name="AvatarCheck" Content="保存头像" IsChecked="True" Margin="0,8,20,0"/><CheckBox x:Name="EmojiCheck" Content="保存 QQ 表情" IsChecked="True" Margin="0,8,20,0"/><CheckBox x:Name="CollectComments" Content="采集评论与回复" IsChecked="True" Margin="0,8,20,0"/><CheckBox x:Name="LikesCheck" Content="点赞者名单" Margin="0,8,20,0"/><CheckBox x:Name="RefreshCheck" Content="深度复核全部正文与评论"/></WrapPanel>
    <Border Background="#EFF4F7" Padding="12" Margin="0,14,0,0" CornerRadius="6"><StackPanel><TextBlock Text="这次想保存哪些日子？" FontWeight="Bold"/><WrapPanel Margin="0,9,0,0"><ComboBox x:Name="ScopeBox" SelectionChanged="Scope_Changed" Width="175" SelectedIndex="0" Padding="6"><ComboBoxItem Content="智能续传 / 核对变化"/><ComboBoxItem Content="只备份最近 N 条"/><ComboBoxItem Content="按日期备份"/><ComboBoxItem Content="只补已有档案"/></ComboBox><TextBlock Text=" 条数 " VerticalAlignment="Center"/><TextBox x:Name="LimitBox" Text="50" Width="65" Padding="7,5"/><TextBlock Text=" 附件并发 " VerticalAlignment="Center"/><ComboBox x:Name="WorkersBox" Width="75" SelectedIndex="1"><ComboBoxItem Content="1 路"/><ComboBoxItem Content="4 路"/><ComboBoxItem Content="8 路"/></ComboBox></WrapPanel><WrapPanel Margin="0,10,0,0"><TextBlock Text="日期从 " VerticalAlignment="Center"/><DatePicker x:Name="BackupFrom" Width="135"/><TextBlock Text=" 至 " VerticalAlignment="Center"/><DatePicker x:Name="BackupThrough" Width="135"/></WrapPanel><TextBlock Text="最近 N 条和日期范围会单独保存。只补已有档案跳过列表，优先使用已打开的同账号档案。" FontSize="11" Foreground="#73889B" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
<Expander x:Name="VerifyExpander" Header="快速验证一条说说（可选）" Margin="0,12,0,0"><StackPanel><TextBlock Text="粘贴说说链接或 ID，可用空格分隔多条。留空导出全部。验证结果单独保存。" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,7" Foreground="#78867B"/><TextBox x:Name="VerifyBox"/></StackPanel></Expander><Expander Header="可选附加模块" Margin="0,15,0,0"><StackPanel><WrapPanel><CheckBox x:Name="BoardsCheck" Content="留言板（实验性）" Margin="0,8,20,0"/><CheckBox x:Name="SharesCheck" Content="独立分享页（暂不支持）" IsEnabled="False"/></WrapPanel><TextBlock Text="附加模块保存接口原始记录。空间日志、独立相册、QQ 聊天记录暂不支持。" FontSize="11" Foreground="#81907E" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Expander>
   </StackPanel></Border>
   <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock x:Name="PostsCount" Text="0" FontSize="29"/><TextBlock Text="已保存说说" Foreground="#7A897B" FontSize="12"/></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Name="CommentsCount" Text="0" FontSize="29"/><TextBlock Text="评论与回复" Foreground="#7A897B" FontSize="12"/></StackPanel><StackPanel Grid.Column="2"><TextBlock x:Name="MediaCount" Text="0" FontSize="29"/><TextBlock Text="本地媒体" Foreground="#7A897B" FontSize="12"/></StackPanel><StackPanel Grid.Column="3"><TextBlock x:Name="IssuesCount" Text="0" FontSize="29" Foreground="#A0793D"/><TextBlock Text="待核对项" Foreground="#7A897B" FontSize="12"/></StackPanel>
   </Grid>
   <DockPanel Margin="0,0,0,12"><TextBlock Text="03  采集与核对" FontSize="16" FontWeight="Bold"/><TextBlock x:Name="StageLabel" Text="准备就绪" HorizontalAlignment="Right" Foreground="#6C8170"/></DockPanel>
   <ProgressBar x:Name="ProgressBar" Height="5" Foreground="#408166" Background="#E3E8DA" BorderThickness="0" Margin="0,0,0,15"/>

   <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Height="135" Margin="0,17,0,0" Background="#EFF1E9" BorderThickness="0" FontSize="11" Foreground="#64766B"/>
   <TextBlock Text="以当前账号可访问的数据为准。无法取到的内容会进入核对报告，程序不会把失败页当作“没有内容”。" FontSize="11" Foreground="#899382" TextWrapping="Wrap" Margin="0,12,0,0"/>
  </StackPanel></ScrollViewer><Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#CEDDE9" BorderThickness="0,1,0,0" Padding="24,14"><WrapPanel><Button x:Name="StartButton" Content="开始 / 接着上次备份" Click="Start_Click" Background="#477FAD" Foreground="White"/><Button x:Name="PauseButton" Content="暂停" Click="Pause_Click" IsEnabled="False"/><Button x:Name="StopButton" Content="停止并保存" Click="Stop_Click" IsEnabled="False"/><Button x:Name="OpenButton" Content="打开离线档案 ↗" Click="Open_Click"/></WrapPanel></Border></Grid></TabItem>
<TabItem Header="02  档案整理与导出"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="我的空间档案" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="检索 · 对比合并 · 按需导出，让回忆可以阅读，也可以分析。" Foreground="#718274" Margin="0,8,0,16"/><WrapPanel><Button Content="打开 JSON 档案" Click="LoadArchive_Click"/><Button Content="导入、合并与去重" Click="MergeArchive_Click"/><Button Content="补采当前档案" Click="TopUpLibrary_Click"/><Button Content="生成离线 Gallery ↗" Click="Gallery_Click"/></WrapPanel><TextBlock x:Name="LibraryStatus" Text="打开本工具的 archive.json 开始整理。" TextWrapping="Wrap" Margin="0,12"/></StackPanel>
<StackPanel Grid.Row="1"><TextBlock Text="搜索关键词（正文、转发、作者和评论）" Foreground="#718274" FontSize="11" Margin="0,0,0,6"/><TextBox x:Name="SearchBox" ToolTip="搜索正文、作者、转发及评论；多个词以空格分隔" TextChanged="Filter_Changed"/><WrapPanel Margin="0,10"><TextBlock Text="日期从 " VerticalAlignment="Center"/><DatePicker x:Name="FromDate" Width="125" SelectedDateChanged="Filter_Changed"/><TextBlock Text=" 至 " VerticalAlignment="Center"/><DatePicker x:Name="ThroughDate" Width="125" SelectedDateChanged="Filter_Changed"/><ComboBox x:Name="KindBox" Width="110" SelectedIndex="0" Margin="10,0" SelectionChanged="Filter_Changed"><ComboBoxItem Content="全部"/><ComboBoxItem Content="含图片"/><ComboBoxItem Content="含视频"/><ComboBoxItem Content="有评论"/><ComboBoxItem Content="转发分享"/></ComboBox><Button Content="清空筛选" Click="ResetFilter_Click" Padding="12,5"/></WrapPanel><TextBlock x:Name="MatchCount" Foreground="#718274" Margin="0,0,0,8"/></StackPanel>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions><ListBox x:Name="ArchiveList" SelectionMode="Extended"  SelectionChanged="ArchiveSelection_Changed" BorderBrush="#CEDDE9" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="Wrap" LineHeight="23"/></DataTemplate></ListBox.ItemTemplate></ListBox><TextBox x:Name="ArchivePreview" Grid.Column="1" Margin="12,0,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="点击记录阅读完整正文和评论。可用 Ctrl / Shift 多选。"/></Grid>
<Border Grid.Row="3" Background="#DFEAF3" CornerRadius="12" Padding="16" Margin="0,16,0,0"><StackPanel><TextBlock Text="导出给自己，也导出给 AI" FontSize="17" FontWeight="Bold"/><WrapPanel><CheckBox x:Name="BodyOut" Content="正文" IsChecked="True" Margin="0,8,14,0"/><CheckBox x:Name="CommentsOut" Content="评论与回复" IsChecked="True" Margin="0,8,14,0"/><CheckBox x:Name="PicturesOut" Content="图片" IsChecked="True" Margin="0,8,14,0"/><CheckBox x:Name="VideosOut" Content="音视频" IsChecked="True" Margin="0,8,14,0"/><CheckBox x:Name="ForwardsOut" Content="转发与分享" IsChecked="True" Margin="0,8,14,0"/><CheckBox x:Name="LikesOut" Content="点赞者"/></WrapPanel><WrapPanel Margin="0,4,0,12"><CheckBox x:Name="TxtOut" Content="TXT（AI 阅读）" IsChecked="True" Margin="0,8,14,0"/><CheckBox x:Name="HtmlOut" Content="HTML + Gallery" IsChecked="True" Margin="0,8,14,0"/><CheckBox x:Name="JsonOut" Content="JSON（再次导入）" IsChecked="True" Margin="0,8,14,0"/><CheckBox x:Name="OnlySelected" Content="仅导出列表选中项"/></WrapPanel><DockPanel><Button Content="选择位置并导出" Click="ExportArchive_Click" Background="#477FAD" Foreground="White" DockPanel.Dock="Right"/><TextBlock Text="TXT 每 100 条分卷；保留原文、日期、作者和回复层级。&#10;时间筛选包含起止两天；清空日期可查看所有记录。" Foreground="#6A8194" FontSize="11" VerticalAlignment="Center"/></DockPanel></StackPanel></Border>
</Grid></TabItem></TabControl>
 </Grid>
</Window>
